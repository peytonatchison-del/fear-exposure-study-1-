# Copy this file to .env and fill in real values before running the server.

# Port the API server listens on.
PORT=4000

# Secret used to sign researcher-dashboard login tokens.
# Change this to a long random string before any real study data is collected.
JWT_SECRET=change-this-to-a-long-random-string

# Initial researcher dashboard login. Only used the FIRST time the server
# starts (to create the researcher account in the database), and once more
# automatically if you change RESEARCHER_INITIAL_USERNAME on a database that
# still has the untouched default "researcher" account. After that, change
# the password from inside the dashboard's Account tab.
RESEARCHER_INITIAL_USERNAME=researcher
RESEARCHER_INITIAL_PASSWORD=change-me-now

# "demo" or "real".
#   demo -> app is seeded/usable with fake data, real-data endpoints are disabled
#   real -> real participant data collection is enabled (requires the IRB
#           checklist to be completed in the researcher dashboard first)
APP_MODE=demo

# Where the SQLite database file and uploaded stimulus files live.
# Leave both UNSET for local development — they default to folders inside
# this project (server/data and server/uploads) and that's fine.
#
# On a host with an ephemeral filesystem (Railway, etc.), set BOTH of these
# to paths under a mounted persistent volume so your data survives restarts
# and redeploys instead of getting wiped. If your Railway volume is mounted
# at /data, use:
# DATA_DIR=/data/db
# UPLOADS_DIR=/data/uploads
# DATA_DIR=
# UPLOADS_DIR=
